# Tessera server
PORT=4700
HOST=0.0.0.0
# Public URL the browser and reporters use to reach Tessera (used in links, cookies and CORS).
PUBLIC_URL=http://localhost:4700
# PostgreSQL connection string. Required.
DATABASE_URL=postgres://tessera:tessera@localhost:5432/tessera
# Optional: Redis for fan-out across several server replicas. Leave empty for a single replica.
REDIS_URL=
# 32+ random bytes, base64 or hex. Used to sign cookies and device tokens. Required in production.
SECRET_KEY=change-me-to-a-long-random-string
# Set to "production" when deployed. Enables secure cookies and strict host checks.
NODE_ENV=development
# Comma-separated list of hostnames the server will accept in the Host header (besides PUBLIC_URL's host).
ALLOWED_HOSTS=
# First organisation bootstrap: created on first start if no org exists.
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Timings (ms)
STALE_AFTER_MS=15000
DROP_AFTER_MS=60000
LINGER_MS=8000
# Retention
RETAIN_SAMPLES_DAYS=30
RETAIN_EVENTS_DAYS=180
RETAIN_SESSIONS_DAYS=365
# Connections reserved for reporter writes (separate from the console's pool of 20).
INGEST_POOL_SIZE=20
# Bearer token for GET /api/metrics from outside loopback. Empty: loopback only.
METRICS_TOKEN=
# Logging: text | json
LOG_FORMAT=text
LOG_LEVEL=info
